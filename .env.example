# Supabase (Project Settings → API)
# Project ref: kmhaertikrtcvfotufgt
NEXT_PUBLIC_SUPABASE_URL=https://kmhaertikrtcvfotufgt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Solo server (cron discovery) — Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# URL pubblico dell'app (redirect OAuth / conferma email)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Gemini (generazione candidature + discovery)
# Chiave da https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...
# Opzionale: override modello
# GEMINI_MODEL=gemini-3.5-flash

# Mock AI: usa fixtures/ invece di Gemini (dev/test)
USE_AI_MOCK=true
NEXT_PUBLIC_USE_AI_MOCK=true

# Cron discovery (Authorization: Bearer …)
CRON_SECRET=

# Figma multi-tenant (OAuth per utente + plugin export)
# Crea un'app su https://www.figma.com/developers/apps
# Scopes: file_content:read, current_user:read
# Redirect URI: {NEXT_PUBLIC_SITE_URL}/api/figma/callback
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
# Opzionale (default: {SITE}/api/figma/callback)
# FIGMA_REDIRECT_URI=
# Nome text node target del plugin (default __cv_body__)
# FIGMA_CV_TEXT_NODE_NAME=__cv_body__
# Serve SUPABASE_SERVICE_ROLE_KEY per salvare i token OAuth.
