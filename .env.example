# Supabase (Project Settings → API)
# Project ref: kmhaertikrtcvfotufgt
NEXT_PUBLIC_SUPABASE_URL=https://kmhaertikrtcvfotufgt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Solo server (cron discovery) — Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# URL pubblico dell'app (redirect OAuth / conferma email)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Gemini (generazione candidature + discovery)
# Chiave da https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...
# Opzionale: override modello
# GEMINI_MODEL=gemini-2.5-flash

# Mock AI: usa fixtures/ invece di Gemini (dev/test)
USE_AI_MOCK=true
NEXT_PUBLIC_USE_AI_MOCK=true

# Cron discovery (Authorization: Bearer …)
CRON_SECRET=

# --- Fase 2: Figma ---
# Token personale: https://www.figma.com/developers/api#access-tokens
FIGMA_ACCESS_TOKEN=
# Working copy obbligatoria PRIMA di qualsiasi scrittura testuale (≠ file originale)
# Opzione A: webhook/plugin che duplica il file e restituisce { "file_key": "..." }
# FIGMA_DUPLICATE_WEBHOOK_URL=https://...
# Opzione B: file key di una copia pre-provisionata (mai uguale all'originale)
# FIGMA_WORKING_COPY_FILE_KEY=
# Webhook/plugin che scrive text nodes SOLO sulla working copy
# FIGMA_TEXT_WRITE_WEBHOOK_URL=https://...
# Opzionale: node id TEXT del CV (default __cv_body__)
# FIGMA_CV_TEXT_NODE_ID=
